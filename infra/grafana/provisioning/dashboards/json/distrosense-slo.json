      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(detected_at, '1m'), anomaly_type AS metric, count(*) AS value FROM anomaly_events WHERE $__timeFilter(detected_at) GROUP BY 1, 2 ORDER BY 1"
