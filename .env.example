# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# TimescaleDB
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432
TIMESCALE_DB=distrosense
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=postgres

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=distrosense

# Elasticsearch
ES_HOST=http://localhost:9200

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# ML Service
ML_SERVICE_HOST=localhost
ML_SERVICE_PORT=50051
TORCHSERVE_HOST=localhost
TORCHSERVE_PORT=8080

# Slack
SLACK_BOT_TOKEN=xoxb-your-token-here
SLACK_CHANNEL=#incidents

# LLM runbook suggester (response orchestrator)
# LLM_PROVIDER: "gemini" (default) or "xai". Unset = inferred from the key (xAI keys start "xai-").
LLM_PROVIDER=gemini
LLM_API_KEY=your-key-here
# Blank = provider default (gemini-flash-lite-latest / grok-4).
LLM_MODEL=gemini-flash-lite-latest

# Kubernetes (response orchestrator)
K8S_NAMESPACE=default
# kubeconfig context to act on (blank = current context). Pin it so a stray
# `kubectl config use-context` can't point the orchestrator at another cluster.
K8S_CONTEXT=docker-desktop

# Response orchestrator tuning (all optional; defaults shown)
# ORCH_METRICS_PORT=9103
# ORCH_COOLDOWN_SECONDS=300
# ORCH_MAX_INCIDENT_AGE_SECONDS=3600
# HPA_REVERT_AFTER_SECONDS=900

# Correlation engine (optional)
# CORRELATION_METRICS_PORT=9102
# CORRELATION_AUTO_OFFSET_RESET=earliest

# Environment
ENV=development
LOG_LEVEL=INFO